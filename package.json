    "katex": "^0.19.0",
    "mantine-datatable": "^9.4.0",
    "marked-react": "^4.0.0",
    "ms": "^2.1.3",
    "nuqs": "^2.10.2",
    "otplib": "^13.5.0",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
